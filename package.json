    "nodemon/**/brace-expansion": "1.1.21",
    "venom-bot/commitizen/**/brace-expansion": "1.1.21",
    "venom-bot/cz-conventional-changelog/**/brace-expansion": "1.1.21",
    "venom-bot/puppeteer-extra-plugin-stealth/**/brace-expansion": "1.1.21",
    "venom-bot/commitizen/inquirer/external-editor/tmp": "0.2.7",
    "venom-bot/cz-conventional-changelog/commitizen/inquirer/external-editor/tmp": "0.2.7",
