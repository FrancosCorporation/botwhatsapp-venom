    "ws": "8.22.0",
    "tar-fs": "2.1.5",
    "js-yaml": "4.3.2",
    "picomatch": "2.3.2",
    "micromatch": "4.0.8",
    "word-wrap": "1.2.5",
    "diff": "4.0.4",
    "venom-bot/sharp": "0.35.5",
    "nodemon/semver": "5.7.2",
    "nodemon/simple-update-notifier/semver": "7.5.2",
    "venom-bot/**/semver": "7.5.2",
    "nodemon/minimatch": "3.1.4",
